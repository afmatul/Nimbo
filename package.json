{
  "name": "nimbo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "test": "jest --config jest.config.cjs && pnpm -r run test",
    "test:int": "pnpm --filter api run test:int",
    "test:isolation": "pnpm --filter api run test:isolation",
    "test:e2e": "node scripts/placeholder.mjs \"sin pruebas E2E aún (000b/023)\"",
    "seed": "node scripts/placeholder.mjs \"seed pendiente (005/019)\"",
    "env:check": "node scripts/placeholder.mjs \"env:check pendiente (000 T-23)\""
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  }
}
