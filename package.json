{
  "name": "nimbo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "start:all": "node scripts/start-all.mjs",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings 0 && prettier --check .",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "test": "jest --config jest.config.cjs && pnpm -r run test",
    "test:int": "pnpm --filter api run test:int",
    "test:isolation": "pnpm --filter api run test:isolation",
    "test:e2e": "node scripts/placeholder.mjs \"sin pruebas E2E aún (000b/023)\"",
    "seed": "pnpm --filter api seed",
    "env:check": "tsx scripts/check-env-example.ts",
    "db:app-role": "docker compose exec -T postgres sh /docker-entrypoint-initdb.d/10-nimbo-app.sh"
  },
  "devDependencies": {
    "@nimbo/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "pnpm": {
    "overrides": {
      "strnum": "2.4.2"
    }
  }
}
