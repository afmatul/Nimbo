# nimbo-worker en Deploya (docs/operations/deploya.md). Solo lo obligatorio de `workerEnvSchema`. NODE_ENV viene de la
# imagen y DATABASE_URL, REDIS_URL y MINIO_* de los recursos de datos compartidos por nimbo-api (vía entrypoint).
# Salud en WORKER_PORT=3001 (valor por omisión), el mismo puerto del proyecto.
APP_ENV=staging
LOG_LEVEL=info
# La misma de nimbo-api.
NIMBO_APP_DB_PASSWORD=<la-de-nimbo-api>
MINIO_BUCKET=app
# SMTP real con TLS (en staging `none` se rechaza, 001 CA-20).
SMTP_HOST=<servidor-smtp>
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=<usuario-smtp>
SMTP_PASSWORD=<genera-uno>
MAIL_FROM=<remitente-smtp>
# Opcional: vacía = la indexación termina `fallido/proveedor_no_disponible` (RNF-09).
GEMINI_API_KEY=
