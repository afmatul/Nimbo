# nimbo-api en Deploya (docs/operations/deploya.md). Solo lo obligatorio de `apiEnvSchema`; lo demás toma su valor
# por omisión. No van aquí, porque las pone la imagen o Deploya:
#   - NODE_ENV=production y PORT (Dockerfile; Deploya inyecta PORT=3000);
#   - DATABASE_URL, DATABASE_MIGRATION_URL, REDIS_URL y MINIO_* (el entrypoint las traduce de los recursos de datos).
# Reemplaza cada `<genera-uno>` con `openssl rand -base64 48 | tr -d '\n=+/'` antes de pegar.
APP_ENV=staging
LOG_LEVEL=info
WEB_PUBLIC_URL=https://nimbo.deploya.larasolutions.dev
CORS_ORIGIN=https://nimbo.deploya.larasolutions.dev
# Al menos 43 caracteres en staging (002 CA-26).
JWT_ACCESS_SECRET=<genera-uno>
# Contraseña del rol `nimbo_app`: la misma en api, worker y optimizer. El entrypoint del api crea el rol con ella.
NIMBO_APP_DB_PASSWORD=<genera-uno>
# Bucket que crea Deploya (con versionado); el entrypoint ya lo toma de S3_BUCKET, se deja explícito.
MINIO_BUCKET=app
# Opcional: vacía = el agente responde AGENT_UNAVAILABLE (RNF-09). ONLYOFFICE_* no se definen: sin edición en línea.
GEMINI_API_KEY=
