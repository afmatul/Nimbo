# Nimbo — variables de entorno (spec 000, CA-19). Copia este archivo: `cp .env.example .env`.
# Valores listos para local. Los secretos de staging quedan vacíos y se rellenan solo en el servidor.
# Ninguna variable secreta usa el prefijo `NEXT_PUBLIC_` (CA-29): `web` lee todo en el servidor.
# `scripts/check-env-example.ts` (`pnpm env:check`) comprueba que este archivo y los esquemas coincidan.

# ── Proceso (api, worker, web) ───────────────────────────────────────────────
# Modo de Node: development | test | production
NODE_ENV=development
# Ambiente lógico: local | test | staging | production (aparece en la página de estado y en bitácoras)
APP_ENV=local
# Versión desplegada; en imágenes publicadas es `sha-<short>` y se expone en la cabecera `x-nimbo-version` (CA-31)
APP_VERSION=dev
# Puerto HTTP de `api` (en local corre en el host; Traefik enruta `/api` hacia él)
PORT=3000
# Puerto interno de salud del `worker` (`/health/live`, `/health/ready`); nunca se publica en compose (CA-23)
WORKER_PORT=3001
# Nivel de bitácora de Pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Dependencias (api, worker) ───────────────────────────────────────────────
# Cadena de conexión a Postgres de api y worker: rol `nimbo_app`, sin superusuario ni BYPASSRLS (ADR-0005; secreto)
DATABASE_URL=postgres://nimbo_app:nimbo_app@localhost:5432/nimbo
# Cadena de conexión de las migraciones: rol dueño de las tablas (`POSTGRES_USER`); api y worker no la leen (secreto)
DATABASE_MIGRATION_URL=postgres://nimbo:nimbo@localhost:5432/nimbo
# Cadena de conexión a Redis (BullMQ y caché)
REDIS_URL=redis://localhost:6379
# Endpoint S3 de MinIO (API, puerto 9000; la consola 9001 no la usa la app)
MINIO_ENDPOINT=http://localhost:9000
# Credenciales S3 con las que `api` y `worker` acceden al bucket (secreto; ambos procesos las validan)
MINIO_ACCESS_KEY=nimbo
MINIO_SECRET_KEY=nimbo-secret
# Bucket único de archivos, creado con versionado por `infra/minio/init.sh`
MINIO_BUCKET=nimbo
# Región nominal que exige el SDK de S3
MINIO_REGION=us-east-1

# ── api: carga y descarga de archivos (spec 005) ────────────────────────────
# Host público de MinIO contra el que se firman las URLs de carga y descarga; distinto de web y API y nunca un
# prefijo de ruta (un `stripprefix` invalida la firma). Staging: https://s3.staging.nimbo.me
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Tamaño de cada parte de una carga por partes, en bytes (mínimo 5 MiB = 5242880; 8 MiB por defecto)
UPLOAD_PART_SIZE_BYTES=8388608
# Desde este tamaño en bytes la carga es por partes (≥ UPLOAD_PART_SIZE_BYTES; 16 MiB por defecto)
UPLOAD_MULTIPART_THRESHOLD_BYTES=16777216
# Vigencia en segundos de las URLs prefirmadas de carga (60–86400); `resume` las renueva
UPLOAD_URL_TTL_SECONDS=3600
# Inicios de carga por usuario y minuto (RN-16)
RATE_LIMIT_UPLOAD_INIT_PER_MINUTE=300
# URLs de descarga por usuario y minuto (RN-16)
RATE_LIMIT_DOWNLOAD_URL_PER_MINUTE=120
# Restauraciones de versiones por usuario y minuto (spec 014; cada una copia el archivo en MinIO)
RATE_LIMIT_VERSION_RESTORE_PER_MINUTE=30

# ── worker: limpieza de cargas vencidas (spec 005) ───────────────────────────
# Cada cuántos minutos corre el barrido de cargas vencidas (24 h)
UPLOAD_CLEANUP_INTERVAL_MINUTES=10
# Cargas vencidas por barrido (1–1000; la función SQL también acota a 1000)
UPLOAD_CLEANUP_BATCH_SIZE=100

# ── api: carpetas (spec 006) ──────────────────────────────────────────────────
# Niveles máximos del árbol de carpetas (1–50); crear, mover o restaurar por encima responde 422
FOLDER_MAX_DEPTH=10

# ── api: accesos rápidos de la barra lateral (spec 006) ──────────────────────
# Elementos fijados por cuenta (1–20); fijar uno más responde 422 STORAGE_QUICK_ACCESS_LIMIT
QUICK_ACCESS_MAX_PINNED=5
# Recientes que muestra la barra lateral antes de «Ver más» (1–20)
QUICK_ACCESS_RECENT_VISIBLE=3

# ── worker: purga de la papelera (spec 006) ───────────────────────────────────
# Cada cuántos minutos corre la purga de elementos con la retención vencida
TRASH_PURGE_INTERVAL_MINUTES=60
# Elementos vencidos por ciclo (1–1000; la función SQL también acota a 1000)
TRASH_PURGE_BATCH_SIZE=100

# ── worker: conciliación del espacio usado (spec 007) ─────────────────────────
# Cada cuántos minutos se recalcula el espacio usado de cada cuenta (por defecto, una vez al día)
USAGE_RECONCILE_INTERVAL_MINUTES=1440
# Cuentas por página del recorrido (1–1000)
USAGE_RECONCILE_BATCH_SIZE=100

# ── worker: conciliación de suscripciones (spec 009) ─────────────────────────
# Cada cuántos minutos todo cliente verificado sin suscripción recibe el plan Personal
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=60
# Cuentas por página del recorrido (1–1000)
SUBSCRIPTION_RECONCILE_BATCH_SIZE=100

# ── worker: reintento de facturas sin PDF (spec 009) ─────────────────────────
# Cada cuántos minutos se emiten las facturas cuyo PDF falló tras el cobro
INVOICE_RETRY_INTERVAL_MINUTES=1
# Facturas por pasada (1–1000)
INVOICE_RETRY_BATCH_SIZE=100

# ── api y worker: aviso previo de la renovación (spec 010) ───────────────────
# Días antes de `vence_en` para el aviso previo y el estado «por vencer» (1–7)
RENEWAL_REMINDER_DAYS=3

# ── api: registro y verificación de correo (spec 001) ────────────────────────
# URL pública de `web`: base del enlace de verificación del correo; https obligatorio en staging y producción
WEB_PUBLIC_URL=http://localhost
# Orígenes que CORS admite en `api`, separados por comas (la página de `web` y su puerto de desarrollo)
CORS_ORIGIN=http://localhost,http://localhost:3002

# ── api: sesiones (spec 002) ─────────────────────────────────────────────────
# Clave HMAC que firma los tokens de acceso (secreto; solo la lee el api). Este valor es SOLO DE DESARROLLO: en staging
# y producción el api lo rechaza y exige al menos 43 caracteres (32 bytes aleatorios en base64url)
JWT_ACCESS_SECRET=solo-desarrollo-local-nunca-usar-en-staging-ni-produccion

# ── worker: envío de correo por SMTP (spec 001; en local, Mailpit del compose) ─
# Servidor SMTP (Mailpit en local; bandeja web en http://localhost:8025)
SMTP_HOST=localhost
# Puerto SMTP (Mailpit: 1025; Resend con TLS implícito: 465)
SMTP_PORT=1025
# Cifrado: none | starttls | implicit (`none` está prohibido en staging y producción)
SMTP_TLS=none
# Usuario SMTP; obligatorio si se define SMTP_PASSWORD (vacío con Mailpit)
SMTP_USER=
# Contraseña SMTP (secreto; solo la lee el worker; vacía con Mailpit)
SMTP_PASSWORD=
# Remitente de los correos de Nimbo
MAIL_FROM=Nimbo <no-responder@nimbo.me>

# ── web ─────────────────────────────────────────────────────────────────────
# URL con la que `web` consulta la API desde el servidor (nunca desde el navegador). Sin `/api/v1`: lo agrega cada cliente
API_INTERNAL_URL=http://localhost:3000
# URL con la que el navegador llama a la API (el Server Component la pasa como prop; sin NEXT_PUBLIC_)
API_PUBLIC_URL=http://localhost/api/v1

# ── compose: Postgres ────────────────────────────────────────────────────────
# Superusuario del contenedor de Postgres: dueño de las tablas; debe coincidir con DATABASE_MIGRATION_URL
POSTGRES_USER=nimbo
# Contraseña de Postgres (secreto)
POSTGRES_PASSWORD=nimbo
# Base de datos que crea el contenedor al iniciar
POSTGRES_DB=nimbo
# Contraseña del rol de aplicación `nimbo_app` que crea `infra/postgres/init/10-nimbo-app.sh` (secreto; debe coincidir con DATABASE_URL)
NIMBO_APP_DB_PASSWORD=nimbo_app

# ── compose: MinIO ───────────────────────────────────────────────────────────
# Usuario raíz de MinIO (mínimo 3 caracteres; en local coincide con MINIO_ACCESS_KEY)
MINIO_ROOT_USER=nimbo
# Contraseña raíz de MinIO (mínimo 8 caracteres; secreto)
MINIO_ROOT_PASSWORD=nimbo-secret

# ── compose: imágenes y dominios (staging; en local se ignoran salvo IMAGE_TAG) ──
# Etiqueta de las imágenes ghcr.io/afmatul/nimbo-{api,worker,web} que corren (`sha-<short>` o `latest`)
IMAGE_TAG=latest
# Dominio base del despliegue (D-3)
DOMAIN=nimbo.me
# Hosts que enruta Traefik en staging (`compose.staging.yml`)
WEB_HOST=staging.nimbo.me
API_HOST=api.staging.nimbo.me
DOCS_HOST=docs.staging.nimbo.me
S3_HOST=s3.staging.nimbo.me
# Correo para los avisos de Let's Encrypt (solo staging/producción)
LETSENCRYPT_EMAIL=
# CA de ACME: el staging de Let's Encrypt hasta estabilizar Traefik (R-5); producción: https://acme-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ── compose: ONLYOFFICE (perfil `onlyoffice`, apagado por defecto; CA-2) ────
# Secreto JWT compartido entre `api` y ONLYOFFICE Docs (secreto; en local cualquier cadena larga sirve)
ONLYOFFICE_JWT_SECRET=cambia-este-secreto-local

# ── compose: límites de memoria de las apps (staging) ───────────────────────
# Bajar a 512m durante demos con el perfil `onlyoffice` activo (plan 000 R-6)
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=768m

# ── compose: selección de archivos (solo staging) ───────────────────────────
# En local no se define: Docker carga compose.yml + compose.override.yml automáticamente.
# COMPOSE_FILE=compose.yml:compose.staging.yml
