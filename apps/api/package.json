{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Nimbo API (NestJS): módulos de la lógica del sistema",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --path tsconfig.worker.json --entryFile worker.main",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:int": "jest -c jest.int.config.cjs",
    "test:isolation": "jest -c jest.isolation.config.cjs",
    "migration:generate": "node scripts/migration-generate.mjs",
    "migration:run": "tsx src/scripts/migrate.ts run",
    "migration:revert": "tsx src/scripts/migrate.ts revert"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "@nimbo/contracts": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.11",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@nimbo/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
