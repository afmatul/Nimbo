{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "Nimbo API (NestJS): módulos de la lógica del sistema",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --path tsconfig.worker.json --entryFile worker.main",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:int": "jest -c jest.int.config.cjs --passWithNoTests",
    "test:isolation": "jest -c jest.isolation.config.cjs --passWithNoTests",
    "migration:generate": "node scripts/migration-generate.mjs",
    "migration:run": "tsx src/scripts/migrate.ts run",
    "migration:revert": "tsx src/scripts/migrate.ts revert"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/typeorm": "11.0.3",
    "@nimbo/contracts": "workspace:*",
    "bullmq": "6.3.8",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@nimbo/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
