{
  "name": "@nimbo/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos HTTP y tipos compartidos entre web y api (fuente única, Art. VI)",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "build:common-passwords": "node scripts/build-common-passwords.mjs"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nimbo/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  }
}
